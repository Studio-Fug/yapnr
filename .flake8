# flake8 settings (Splanc's hook arguments, moved into a config file). black
# formats to 100 columns; flake8 only rejects lines longer than 120.
[flake8]
max-line-length = 120
extend-ignore = E203
extend-exclude =
    bazel-*,
    .bazel-*,
    .bazelisk,
    docs/site,
    third_party
# Baseline for the imported engine (PR3a): the codes each file under hardware/
# still has after black and isort, per file, so every other file and every
# other code is checked in full. PR3a fixed none of them by hand: removing an
# unused import or variable changes the code key of the evaluation modules
# (routing feedback would refuse its libraries and trials), and an unused
# import is still a module attribute that tests patch or other modules import.
# This list only shrinks; PR3b burns it down with the rename. F821 in
# via_coalesce.py is a real defect (migration plan, Appendix B).
# See what a file still has: flake8 --per-file-ignores= <file> (479 findings at PR3a).
per-file-ignores =
    hardware/pnr/pnr/congestion_diagnostics.py: E501,E731
    hardware/pnr/pnr/drc_warm/host.py: E402
    hardware/pnr/pnr/drc_warm/launch_host.py: F401
    hardware/pnr/pnr/drc_warm/model.py: F841
