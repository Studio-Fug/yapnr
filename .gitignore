# --- Bazel ------------------------------------------------------------------
# Convenience symlinks (--symlink_prefix=bazel- in .bazelrc).
/bazel-*
# Project-local content-addressed caches (.bazelrc) and bazelisk downloads
# (.bazeliskrc). MODULE.bazel.lock IS committed.
/.bazel-disk-cache/
/.bazel-repo-cache/
/.bazelisk/
# Per-user Bazel settings (output_base, lowmem, ...); see DEVELOPERS.md.
/user.bazelrc

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/

# --- yapnr project stores and local settings --------------------------------
.yapnr/
yapnr.local.toml
# `yapnr fab build`'s default --out when run from the repo root without one.
/yapnr-fab/

# --- Docs build output (bazel run //docs:build) -----------------------------
/docs/site/
/docs/_build/

# --- Local drops / OS -------------------------------------------------------
*.zip
.DS_Store
# ...except the generated fab packages of the RF coupons (python -m yapnr.rf.coupons generate)
!/examples/rf-coupons/*/fab/*-fab.zip

# `yapnr atopile build` outputs (default ./yapnr-out/<project>/<build>)
yapnr-out/

# Locally built native FDTD stepper (python -m yapnr.rf.fdtd.native_kernel build)
yapnr/rf/fdtd/native/libyapnr_fdtd.*

# Locally built native maze kernel (python -m pnr.route.detail.native_maze build)
hardware/pnr/pnr/route/detail/native/libpnr_maze.*
