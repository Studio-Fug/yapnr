"""yapnr: yet another place and route (printed circuit boards).

Bazel is the build and test entry point (see DEVELOPERS.md). Pins and their
rationale are recorded in docs/decisions.md; update both together.

Compatibility with downstream consumers (Splanc imports yapnr as a bazel_dep,
see docs/migration-plan.md section 4.3):
  - Bazel 7.7.1 (.bazelversion), the same as Splanc.
  - The pip hub name `yapnr_pypi` must stay unique across modules (Splanc's
    hub is `pypi`).
  - The Python 3.11 toolchain is requested with is_default = True; a root
    module's default wins over ours, so nothing here may assume it owns the
    default interpreter.
  - No root-module-only extension tags outside dev_dependency.

No `version` here: the release tag is the only version source (docs/releases.md).
Consumers pin yapnr with a non-registry override (git_override, archive_override),
which ignores the module version; the BCR copy gets its version patched in when
it is published.
"""

module(name = "yapnr")

bazel_dep(name = "rules_python", version = "2.0.3")

# ---------------------------------------------------------------------------
# Python: hermetic 3.11 interpreter (no system Python needed for the build).
# ---------------------------------------------------------------------------

PYTHON_VERSION = "3.11"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

# ---------------------------------------------------------------------------
# pip dependencies: one root lockfile (requirements.lock) resolved from
# requirements.in. Regenerate with `bazel run //:requirements.update`.
#
# The lock is resolved on darwin-arm64 and is also valid on linux-aarch64
# (torch < 2.4 ships CPU-only aarch64 wheels). It is NOT valid on
# linux-x86_64: the x86_64 torch wheel needs CUDA libraries the lock does not
# list. The required CI test job therefore runs on ubuntu-24.04-arm; an
# x86_64 lock (requirements_by_platform) is planned for PR6a.
# ---------------------------------------------------------------------------

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "yapnr_pypi",
    python_version = PYTHON_VERSION,
    requirements_lock = "//:requirements.lock",
)
use_repo(pip, "yapnr_pypi")

# ---------------------------------------------------------------------------
# Third-party JavaScript for the viewer (//yapnr/viewer:dist), fetched at
# build time and pinned by sha256; never vendored (docs/decisions.md). The
# files are served to the browser unmodified and separately, never bundled or
# minified with yapnr's own code (elkjs is EPL-2.0). Repositories are fetched
# lazily: only a build of the viewer downloads them. Licenses: THIRD_PARTY.md.
# ---------------------------------------------------------------------------

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# elkjs 0.9.3 (EPL-2.0, with an Apache-2.0 web-worker shim): the schematic
# view's layered graph layout.
http_archive(
    name = "elkjs",
    build_file_content = 'exports_files(["lib/elk.bundled.js", "LICENSE.md"], visibility = ["//visibility:public"])',
    sha256 = "b95b224bd1ab71fd40f6d9a6365c28d989745dff6b0d514407bc1eb68f2f561e",
    strip_prefix = "package",
    urls = ["https://registry.npmjs.org/elkjs/-/elkjs-0.9.3.tgz"],
)

# three.js 0.186.1 (MIT) with the loaders and controls the 3D view imports.
http_archive(
    name = "threejs",
    build_file_content = """exports_files(
    [
        "LICENSE",
        "build/three.core.js",
        "build/three.module.js",
        "examples/jsm/controls/OrbitControls.js",
        "examples/jsm/loaders/GLTFLoader.js",
        "examples/jsm/utils/BufferGeometryUtils.js",
        "examples/jsm/utils/SkeletonUtils.js",
    ],
    visibility = ["//visibility:public"],
)""",
    sha256 = "8cd068708ea44f2c73c944b1cead2ba2f0d5c15c8fc194e5700f4e4f4a033fe7",
    strip_prefix = "package",
    urls = ["https://registry.npmjs.org/three/-/three-0.186.1.tgz"],
)
