"""yapnr: yet another place and route (printed circuit boards).

Bazel is the build and test entry point (see DEVELOPERS.md). Pins and their
rationale are recorded in docs/decisions.md; update both together.

Compatibility with downstream consumers (Splanc imports yapnr as a bazel_dep,
see docs/migration-plan.md section 4.3):
  - Bazel 7.7.1 (.bazelversion), the same as Splanc.
  - The pip hub name `yapnr_pypi` must stay unique across modules (Splanc's
    hub is `pypi`).
  - The Python 3.11 toolchain is requested with is_default = True; a root
    module's default wins over ours, so nothing here may assume it owns the
    default interpreter.
  - No root-module-only extension tags outside dev_dependency.
"""

module(
    name = "yapnr",
    version = "0.0.0",
)

bazel_dep(name = "rules_python", version = "2.0.3")

# ---------------------------------------------------------------------------
# Python: hermetic 3.11 interpreter (no system Python needed for the build).
# ---------------------------------------------------------------------------

PYTHON_VERSION = "3.11"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

# ---------------------------------------------------------------------------
# pip dependencies: one root lockfile (requirements.lock) resolved from
# requirements.in. Regenerate with `bazel run //:requirements.update`.
#
# The lock is resolved on darwin-arm64 and is also valid on linux-aarch64
# (torch < 2.4 ships CPU-only aarch64 wheels). It is NOT valid on
# linux-x86_64: the x86_64 torch wheel needs CUDA libraries the lock does not
# list. The required CI test job therefore runs on ubuntu-24.04-arm; an
# x86_64 lock (requirements_by_platform) is planned for PR6a.
# ---------------------------------------------------------------------------

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "yapnr_pypi",
    python_version = PYTHON_VERSION,
    requirements_lock = "//:requirements.lock",
)
use_repo(pip, "yapnr_pypi")
