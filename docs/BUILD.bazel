"""Documentation: the Sphinx (MyST) site.

    bazel run //docs:build      # -> docs/site/html/index.html
    bazel run //docs:serve      # preview over HTTP on 127.0.0.1

The content (Markdown under docs/ and the top-level documents, plus the Sphinx
project in docs/_sphinx/) is read live from the working tree at build time, so
the pip toolchain is the only thing Bazel provides here.
"""

load("@rules_python//python:defs.bzl", "py_binary")
load("@yapnr_pypi//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "build",
    srcs = ["build_docs.py"],
    main = "build_docs.py",
    deps = [
        requirement("furo"),
        requirement("myst-parser"),
        requirement("sphinx"),
        requirement("sphinx-copybutton"),
        requirement("sphinx-design"),
        requirement("sphinxcontrib-mermaid"),
    ],
)

py_binary(
    name = "serve",
    srcs = ["serve.py"],
    main = "serve.py",
)

# The annotated owner configuration of `yapnr exp` (tests/unit/exp checks that it parses) and
# the PNR_GLOSS functional groups of ladder case 07-chaser-20 (the regression contract checks
# that every net exists in the design).
exports_files([
    "examples/cloud.toml.example",
    "examples/gloss-groups-chaser.json",
])

exports_files(
    ["agent-workflow.md"],
    visibility = ["//visibility:public"],
)
