(version 1)
# radar60 Rev A custom rules. Generated by examples/radar60/board/gen_board.py from floorplan.yaml
# and the fab profile; do not edit. Part 1 is the pcbway-adv-6l-rf profile's rules, copied from
# pnr.fab_profile.dru_text (yapnr writes those alone beside a board that has no rules file;
# this file carries them and the board's rules, so yapnr leaves it as it is). Part 2 is the
# board's own rules: RF keepouts (rule areas RF_REGION, RF_POCKET, RF_GUARD in radar60.kicad_pcb),
# fence vias, BGA escape classes, noise distances, LVDS and QSPI. Of several matching rules of
# one constraint type, the later wins.

# ---- Part 1: profile pcbway-adv-6l-rf
# SMD pad to pad, different nets (clearance applies to different nets only): P-cap (4 mil spacing, as clearance_mm)
(rule "pcbway-adv-6l-rf_smd_pad_to_pad"
  (constraint clearance (min 0.1mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD' && A.NetClass != 'PWR' && B.NetClass != 'PWR' && A.NetClass != 'SW' && B.NetClass != 'SW' && A.NetClass != 'XTAL' && B.NetClass != 'XTAL'"))
# Via copper to SMD pad (any net): derived: as clearance_mm (4 mil)
(rule "pcbway-adv-6l-rf_via_to_smd_pad"
  (constraint physical_clearance (min 0.1mm))
  (condition "A.Type == 'Via' && B.Type == 'Pad' && B.Pad_Type == 'SMD'"))
# Via hole to copper (vias and via-class footprint holes under the component PTH drill): P-adv (min spacing between hole and inner or outer conductor 6 mil; P-cap's 6-layer inner isolation is 8 mil normal, 6 mil high difficulty)
(rule "pcbway-adv-6l-rf_via_hole_clearance"
  (constraint hole_clearance (min 0.1524mm))
  (condition "(A.Type == 'Via' || (A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.Hole_Size_X < 0.3mm && A.Hole_Size_Y < 0.3mm))"))
# NPTH hole to copper: derived: NPTH hole to copper kept above the 6 mil P-adv minimum
(rule "pcbway-adv-6l-rf_npth_hole_clearance"
  (constraint hole_clearance (min 0.2mm))
  (condition "(A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical')"))
# Component PTH hole to copper: derived: component PTH hole to copper kept above the 6 mil P-adv minimum
(rule "pcbway-adv-6l-rf_pth_hole_clearance"
  (constraint hole_clearance (min 0.2mm))
  (condition "(A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && (A.Hole_Size_X >= 0.3mm || A.Hole_Size_Y >= 0.3mm)) && !(B.Type == 'Via' || (B.Type == 'Pad' && B.Pad_Type == 'Through-hole' && B.Hole_Size_X < 0.3mm && B.Hole_Size_Y < 0.3mm))"))
# Hole-to-hole, via to via: P-cap (hole to hole spacing, via of 0.45 mm or less: 11 mil normal)
(rule "pcbway-adv-6l-rf_via_hole_to_hole"
  (constraint hole_to_hole (min 0.28mm))
  (condition "(A.Type == 'Via' || (A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.Hole_Size_X < 0.3mm && A.Hole_Size_Y < 0.3mm)) && (B.Type == 'Via' || (B.Type == 'Pad' && B.Pad_Type == 'Through-hole' && B.Hole_Size_X < 0.3mm && B.Hole_Size_Y < 0.3mm))"))
# Hole-to-hole, any pair involving a component PTH: P-cap (hole to hole spacing, component hole: 16 mil normal)
(rule "pcbway-adv-6l-rf_component_pth_hole_to_hole"
  (constraint hole_to_hole (min 0.41mm))
  (condition "(A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && (A.Hole_Size_X >= 0.3mm || A.Hole_Size_Y >= 0.3mm))"))
# Minimum NPTH drill: derived: the yapnr PCBWay convention; P-cap non-plated slots are 0.8 mm or more
(rule "pcbway-adv-6l-rf_npth_min_drill"
  (constraint hole_size (min 0.5mm))
  (condition "(A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical')"))
# Hole to edge to the outline centreline (KiCad measures to the stroke edge: 0.475mm is the limit minus half the 0.05mm Edge.Cuts stroke): derived: the yapnr PCBWay value (hole to routed edge 0.50)
(rule "pcbway-adv-6l-rf_hole_to_edge"
  (constraint physical_hole_clearance (min 0.475mm))
  (condition "A.Layer == 'Edge.Cuts' || B.Layer == 'Edge.Cuts'"))

# ---- Part 2: board rules (floorplan.yaml)
# R2 RF region: no foreign tracks on F.Cu-In2.Cu (macro copper only; plan 5.2, 7.5)
(rule "radar60_rf_region_tracks"
  (constraint disallow track)
  (condition "A.Type == 'Track' && (A.Layer == 'F.Cu' || A.Layer == 'In1.Cu' || A.Layer == 'In2.Cu') && A.intersectsArea('RF_REGION') && !A.hasNetclass('RF')"))
# R2 RF region: no vias but the macro's GND fence vias (RFS-5)
(rule "radar60_rf_region_vias"
  (constraint disallow via)
  (condition "A.Type == 'Via' && A.intersectsArea('RF_REGION') && !(A.hasNetclass('GND') && A.Hole <= 0.155mm)"))
# RFS-5 fence vias: 0.15/0.32 mm; pitch >= 0.45 mm follows from the profile's hole to hole
(rule "radar60_rf_fence_vias"
  (constraint hole_size (min 0.15mm))
  (constraint via_diameter (min 0.32mm))
  (condition "A.Type == 'Via' && A.intersectsArea('RF_REGION')"))
# R2 RF region: no top-side parts but the macro, U1 and the pocket parts
(rule "radar60_rf_region_parts"
  (constraint disallow footprint)
  (condition "A.Type == 'Footprint' && A.Layer == 'F.Cu' && A.intersectsArea('RF_REGION') && A.Reference != 'RFM1' && A.Reference != 'U1' && !A.enclosedByArea('RF_POCKET')"))
# No solder mask over the RF copper (TI SPRACG5): the macro's F.Mask opening bridges its copper by design, inside the RF region or the macro footprint only
(rule "radar60_rf_mask_opening"
  (constraint bridged_mask)
  (severity ignore)
  (condition "A.intersectsArea('RF_REGION') || B.intersectsArea('RF_REGION') || A.memberOfFootprint('RFM1') || B.memberOfFootprint('RFM1') || A.memberOfFootprint('*:RFM1*') || B.memberOfFootprint('*:RFM1*')"))
# The 60 GHz nets never change layer (the RF balls have no vias; plan 7.2)
(rule "radar60_rf_no_vias"
  (constraint disallow via)
  (condition "A.Type == 'Via' && A.hasNetclass('RF')"))
# R4 no digital copper within 5 mm of the RF region on F.Cu-In2.Cu (rectangular band; the package body is exempt)
(rule "radar60_rf_guard_digital"
  (constraint disallow track via)
  (condition "(A.Type == 'Via' || (A.Type == 'Track' && (A.Layer == 'F.Cu' || A.Layer == 'In1.Cu' || A.Layer == 'In2.Cu'))) && A.intersectsArea('RF_GUARD') && A.NetName != '' && !A.hasNetclass('RF') && !A.hasNetclass('PWR') && !A.hasNetclass('GND') && !A.hasNetclass('ANALOG')"))
# BGA escape: signal and power vias under U1 are the 0.20/0.40 escape class (dog-bones); the RF region's vias are the macro's own class
(rule "radar60_bga_signal_vias"
  (constraint hole_size (min 0.2mm))
  (constraint via_diameter (min 0.4mm))
  (condition "A.Type == 'Via' && A.intersectsCourtyard('U1') && !A.hasNetclass('GND') && !A.intersectsArea('RF_REGION')"))
# BGA escape: 0.15/0.35 vias under U1 are GND only (interstitial sites, same net); the macro's 0.15/0.32 fence vias at the package edge are the RF region's class
(rule "radar60_bga_gnd_vias"
  (constraint hole_size (min 0.15mm))
  (constraint via_diameter (min 0.35mm))
  (condition "A.Type == 'Via' && A.intersectsCourtyard('U1') && A.hasNetclass('GND') && !A.intersectsArea('RF_REGION')"))
# Vias away from U1 and the RF region: 0.20/0.40 or larger
(rule "radar60_general_vias"
  (constraint hole_size (min 0.2mm))
  (constraint via_diameter (min 0.4mm))
  (condition "A.Type == 'Via' && !A.intersectsCourtyard('U1') && !A.intersectsArea('RF_REGION')"))
# Crystal nets stay on F.Cu over the solid In1.Cu (no vias; plan 7.1)
(rule "radar60_xtal_no_vias"
  (constraint disallow via)
  (condition "A.Type == 'Via' && A.hasNetclass('XTAL')"))
# Switch nodes >= 8 mm from the crystal nets (noise budget; same-layer copper)
(rule "radar60_sw_to_xtal"
  (constraint clearance (min 8mm))
  (condition "A.hasNetclass('SW') && B.hasNetclass('XTAL')"))
# Switch nodes >= 5 mm from RF copper (R4)
(rule "radar60_sw_to_rf"
  (constraint clearance (min 5mm))
  (condition "A.hasNetclass('SW') && B.hasNetclass('RF')"))
# LVDS pairs: 0.17/0.18 mm (100 ohm on F.Cu over In1.Cu), 0.1 mm intra-pair skew; the breakout under U1 may neck down
(rule "radar60_lvds_pairs"
  (constraint track_width (min 0.15mm) (opt 0.17mm))
  (constraint diff_pair_gap (min 0.16mm) (opt 0.18mm) (max 0.22mm))
  (constraint diff_pair_uncoupled (max 3mm))
  (constraint skew (max 0.1mm) (within_diff_pairs))
  (condition "(A.hasNetclass('LVDS') || A.hasNetclass('dp_lvds_tx0') || A.hasNetclass('dp_lvds_tx1') || A.hasNetclass('dp_lvds_clk') || A.hasNetclass('dp_lvds_frclk')) && !A.intersectsCourtyard('U1')"))
# LVDS on the outer layers only (plan 7.2: F.Cu or B.Cu, next to J2)
(rule "radar60_lvds_outer_layers"
  (constraint disallow track)
  (condition "A.Type == 'Track' && (A.hasNetclass('LVDS') || A.hasNetclass('dp_lvds_tx0') || A.hasNetclass('dp_lvds_tx1') || A.hasNetclass('dp_lvds_clk') || A.hasNetclass('dp_lvds_frclk')) && A.Layer != 'F.Cu' && A.Layer != 'B.Cu'"))
# QSPI at 80 MHz: <= 25 mm routed (plan 3.4 @pnr-si)
(rule "radar60_qspi_length"
  (constraint length (max 25mm))
  (condition "A.hasNetclass('QSPI')"))
# In1.Cu is a GND plane (the RF reference): no tracks
(rule "radar60_plane_in1"
  (constraint disallow track)
  (condition "A.Type == 'Track' && A.Layer == 'In1.Cu'"))
# In4.Cu is a GND plane: no tracks
(rule "radar60_plane_in4"
  (constraint disallow track)
  (condition "A.Type == 'Track' && A.Layer == 'In4.Cu'"))
