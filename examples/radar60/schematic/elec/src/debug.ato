#pragma experiment("TRAITS")
# radar60 development connectors.
# J2: Samtec QTH-030-01-L-D-A for the DCA1000EVM (HQCD-030 cable); pin numbering and signals per
# TI SPRUIJ4A 2.5.3 Table 5 (the DCA1000EVM's J3), assumed pin-for-pin through the cable:
#   7 SPI_CSn, 9 SPI_CLK, 10 HOST_INT, 11 SPI_MOSI, 12 SPI_MISO, 13 PGOOD, 26/28 LVDS_FRCLK P/N,
#   44/46 LVDS_CLK P/N, 50/52 LVDS_1 P/N, 56/58 LVDS_0 P/N, 51 SDA, 53 SCL, 55 RS232RX, 57 RS232TX,
#   59 MCU_RSTn, GND 18/24/30/36/42/48/54/60.
# Unused: 1-3 (5 V from the EVM; the DCA1000 runs from its own supply), DMM/trace (15-17, DP0-15),
# LVDS lanes 2/3 and VALID (two lanes are enough for the 4.1 profile, board-design.md 3.2).
# UART direction follows the ISK Rev D naming (CONN_RS232TX on pin 57): radar TX -> 57, 55 -> radar RX
# (to be confirmed on the bench, open item). MCU_RSTn reaches NRESET only through a DNP 0 Ohm.
# Development builds fit J2; product builds leave it unfitted. Land pattern: Samtec's recommended
# PCB layout (tools/footprints.py:qth030_01_a); MP1-MP4 are the ground-plane lands.
# J3: Arm Cortex 10-pin 1.27 mm debug header (DNP): 1 VTref, 2 TMS, 3 GND, 4 TCK, 5 GND, 6 TDO,
# 7 key, 8 TDI, 9 GNDdetect, 10 nRESET; pinout against the LP-XDS110 to be verified (O7).

import has_net_name_suggestion

import has_designator

from "parts/Radar60_QTH_030_01_L_D_A/Radar60_QTH_030_01_L_D_A.ato" import Radar60_QTH_030_01_L_D_A
from "parts/Radar60_ARM10_1p27_DNP/Radar60_ARM10_1p27_DNP.ato" import Radar60_ARM10_1p27_DNP
from "parts/Radar60_R_0_0402_DNP/Radar60_R_0_0402_DNP.ato" import Radar60_R_0_0402_DNP


module Debug:
    """DCA1000 LVDS/SPI/UART header (development) and the JTAG header (DNP)."""

    signal gnd
    signal v3v3_io
    signal spia_clk
    signal spia_cs_n
    signal spia_mosi
    signal spia_miso
    signal host_intr
    signal pgood
    signal i2c_sda
    signal i2c_scl
    signal uart_tx
    signal uart_rx
    signal nreset
    signal lvds_tx0_p
    signal lvds_tx0_n
    signal lvds_tx1_p
    signal lvds_tx1_n
    signal lvds_clk_p
    signal lvds_clk_n
    signal lvds_frclk_p
    signal lvds_frclk_n
    signal tck
    signal tms
    signal tdi
    signal tdo

    j2 = new Radar60_QTH_030_01_L_D_A
    j2.P7 ~ spia_cs_n
    j2.P9 ~ spia_clk
    j2.P10 ~ host_intr
    j2.P11 ~ spia_mosi
    j2.P12 ~ spia_miso
    j2.P13 ~ pgood
    j2.P26 ~ lvds_frclk_p
    j2.P28 ~ lvds_frclk_n
    j2.P44 ~ lvds_clk_p
    j2.P46 ~ lvds_clk_n
    j2.P50 ~ lvds_tx1_p
    j2.P52 ~ lvds_tx1_n
    j2.P56 ~ lvds_tx0_p
    j2.P58 ~ lvds_tx0_n
    j2.P51 ~ i2c_sda
    j2.P53 ~ i2c_scl
    j2.P55 ~ uart_rx
    j2.P57 ~ uart_tx
    j2.P18 ~ gnd
    j2.P24 ~ gnd
    j2.P30 ~ gnd
    j2.P36 ~ gnd
    j2.P42 ~ gnd
    j2.P48 ~ gnd
    j2.P54 ~ gnd
    j2.P60 ~ gnd
    j2.MOUNT ~ gnd
    signal dca_rst_n
    j2.P59 ~ dca_rst_n
    r_dca_rst = new Radar60_R_0_0402_DNP
    r_dca_rst.p1 ~ dca_rst_n
    r_dca_rst.p2 ~ nreset

    j3 = new Radar60_ARM10_1p27_DNP
    j3.P1 ~ v3v3_io
    j3.P2 ~ tms
    j3.P3 ~ gnd
    j3.P4 ~ tck
    j3.P5 ~ gnd
    j3.P6 ~ tdo
    j3.P8 ~ tdi
    j3.P9 ~ gnd
    j3.P10 ~ nreset

    # net names (net classes and PnR rules refer to these)
    trait dca_rst_n has_net_name_suggestion<name="DCA_RST_N", level="SUGGESTED">

    # fixed designators (board-design.md 2.1)
    trait j2 has_designator<designator="J2">
    trait j3 has_designator<designator="J3">
