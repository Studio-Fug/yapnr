# radar60 Rev A product fit: the same netlist as radar60.ato with the development-only parts
# changed (board-design.md 2.1, 2.2): J2 (DCA1000 header) not fitted, and a 0 Ohm 0612 jumper
# in the 1.0 V shunt footprint instead of the 2 mOhm development shunt.

from "radar60.ato" import Radar60
from "pmic_lp87524j.ato" import Pmic
from "debug.ato" import Debug
from "parts/Radar60_QTH_030_01_L_D_A_DNP/Radar60_QTH_030_01_L_D_A_DNP.ato" import Radar60_QTH_030_01_L_D_A_DNP
from "parts/Radar60_R_0_0612/Radar60_R_0_0612.ato" import Radar60_R_0_0612


module PmicProd from Pmic:
    """Pmic with the 0 Ohm 0612 jumper in the shunt footprint."""
    r_sh -> Radar60_R_0_0612


module DebugProd from Debug:
    """Debug connectors with J2 not fitted."""
    j2 -> Radar60_QTH_030_01_L_D_A_DNP


module Radar60Prod from Radar60:
    """radar60 Rev A, product fit."""
    pmic -> PmicProd
    debug -> DebugProd
