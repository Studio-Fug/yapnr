(version 1)
(rule "MB1: mouse-bite holes inside the tabs (OSH Park tab pattern)"
	(constraint physical_hole_clearance (min 0.005mm))
	(condition "A.memberOfFootprint('MB1') && B.Layer == 'Edge.Cuts'"))
(rule "MO_A01: intentional mask opening over a test line"
	(constraint bridged_mask)
	(condition "A.memberOfFootprint('MO_A01')")
	(severity ignore))
