# Core: graph + constraints + ingest. No torch/numpy — the light path that the
# KiCad pcbnew flow and the schema tests use.
py_library(
    name = "pnr",
    srcs = glob([
        "pnr/*.py",
        "pnr/drc_warm/*.py",
        "pnr/fanout/*.py",
        "pnr/shove/*.py",
        "pnr/si/*.py",
    ]),  # no torch/native imports at package load
    # SI v1 model library (pnr.si.models reads hardware/pnr/si_models next to the package).
    data = glob(["si_models/*.json"]),
    imports = ["."],
    deps = [
        # pnr.fab_profile: vendor data profiles (oshpark-4l, jlc-4l, ...) beside the built-in ones.
        "//yapnr/fab:capability",
        requirement("pyyaml"),  # constraints.py parses the sidecar YAML
    ],
)

# Placement engine (Phase 2): differentiable global placement (torch) + grid
# legalization (numpy). Separated so the core/schema tests stay torch-free.
py_library(
    name = "pnr_place",
    srcs = glob(
        ["pnr/place/*.py"],
        exclude = ["pnr/place/__main__.py"],
    ),
    imports = ["."],
    deps = [
        ":pnr",
        # Line groups (pnr.place.line_group) collapse into pnr.hier.macro macros.
        ":pnr_hier",
        requirement("torch"),
        requirement("numpy"),
    ],
)

# Hierarchical PnR (blocks, macros, sub-boards). Only the viewer's schematic builder
# (pnr.hier.blocks) depends on it so far; PR3b re-homes it under //yapnr/hier.
py_library(
    name = "pnr_hier",
    srcs = glob(["pnr/hier/*.py"]),
    imports = ["."],
    deps = [
        ":pnr",
        requirement("pyyaml"),
    ],
)

# Runnable placer: python -m pnr.place graph.json constraints.yaml [--dump-svg ...]
py_binary(
    name = "place",
    srcs = ["pnr/place/__main__.py"],
    imports = ["."],
    main = "pnr/place/__main__.py",
    deps = [
        ":pnr",
        ":pnr_place",
        requirement("pyyaml"),
    ],
)

# Lookahead global router + place<->route feedback loop (Phase 4). Pure
# python/numpy (no torch of its own) but the feedback loop calls the torch
# placer, so it depends on :pnr_place.
py_library(
    name = "pnr_route",
    srcs = glob(
        ["pnr/route/*.py"],
        exclude = ["pnr/route/__main__.py"],
    ),
    imports = ["."],
    deps = [
        ":pnr",
        ":pnr_place",
        requirement("numpy"),
    ],
)

# Own detailed router (design §Detailed router, R2–R5): grid/obstacle model + a
# multi-layer PathFinder maze router. Pure python/numpy; imports place.geometry
# (torch-containing package, but the router logic is torch-free).
py_library(
    name = "pnr_detail",
    srcs = glob(["pnr/route/detail/*.py"]),
    imports = ["."],
    deps = [
        ":pnr",
        ":pnr_place",
        requirement("numpy"),
    ],
)

# Runnable end-to-end place+route loop: emits the final placed graph JSON that
# the writeback step turns back into a .kicad_pcb. This is the torch-side step
# of the <board>.fab flow.
py_binary(
    name = "pnr_fab",
    srcs = ["pnr/route/__main__.py"],
    imports = ["."],
    main = "pnr/route/__main__.py",
    visibility = ["//visibility:public"],
    deps = [
        ":pnr",
        ":pnr_detail",
        ":pnr_place",
        ":pnr_route",
        requirement("pyyaml"),
    ],
)

