"""Order 0's winner footprints (`yapnr.rf.coupons.catalog.o_optimized`'s D1_WINNER / D2_WINNER):
a filegroup so `//yapnr/rf/coupons`'s Bazel data closure actually contains them. Without this,
a sandboxed `bazel run //yapnr/rf/coupons:cli -- generate --upload D` (or `W`) could not see the
winner file at all and `o_optimized` used to fall back to the placeholder window silently; now
it raises instead (review finding 5), so this filegroup is also what makes the generator work
under Bazel rather than merely fail loudly.
"""

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "winners",
    srcs = [
        "predictions/D1-d1c/runs/d1-star/footprint.kicad_mod",
        "predictions/D1-d1c/runs/d1-star/result.json",
        "predictions/D1/runs/d1-star/footprint.kicad_mod",
        "predictions/D1/runs/d1-star/result.json",
        "predictions/D2/runs/d2-star-sched/footprint.kicad_mod",
        "predictions/D2/runs/d2-star-sched/result.json",
    ],
)
