load("@rules_python//python:defs.bzl", "py_test")

# End-to-end RF inverse design cases (docs/design/rf-topology-optimization.md §11,
# docs/rf-inverse-design.md): optimize, export the footprint, re-simulate it on the
# optimization grid and on a finer grid, and assert the case's criteria.
#
# The full cases are slow (minutes to an hour each on 4 threads) and tagged `manual`; run them
# one at a time, niced, and optionally keep the run directory (a finished run there is only
# re-validated):
#
#   nice -n 10 bazel test --config=lowmem --local_test_jobs=1 //tests/e2e/rf:test_divider \
#     --test_env=YAPNR_RF_RUN_DIR=/path/to/runs
#
# The smoke variants run the same topologies on tiny grids for four iterations (CI, about a
# minute each on one thread).

# The full cases: torch steps the fields on 4 threads; numpy's OpenBLAS (the adjoint sources'
# basis products) stays on one: with its own 4 threads spinning beside torch's, an adjoint run
# used about 7 cores and took 1.6 times as long.
_ENV = {
    "MKL_NUM_THREADS": "4",
    "OMP_NUM_THREADS": "4",
    "OPENBLAS_NUM_THREADS": "1",
}

# The smoke variants (CI): one thread each, so that the tests Bazel runs side by side do not
# oversubscribe the runner (`YAPNR_RF_THREADS` caps torch's threads; design §24), and the long
# timeout (900 s; about a minute each on one thread of the development Mac).
_SMOKE_ENV = {
    "MKL_NUM_THREADS": "1",
    "OMP_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "YAPNR_RF_SMOKE": "1",
    "YAPNR_RF_THREADS": "1",
}

_DEPS = [
    "//yapnr/rf",
    "//yapnr/rf:testing",
]

_FULL_TAGS = [
    "local",
    "manual",
    "no-remote",
    "rf-e2e",
    "slow",
]

py_test(
    name = "test_divider",
    size = "enormous",
    timeout = "eternal",
    srcs = ["test_divider.py"],
    env = _ENV,
    env_inherit = ["YAPNR_RF_RUN_DIR"],
    main = "test_divider.py",
    tags = _FULL_TAGS,
    deps = _DEPS,
)

py_test(
    name = "test_wilkinson",
    size = "enormous",
    timeout = "eternal",
    srcs = ["test_wilkinson.py"],
    env = _ENV,
    env_inherit = ["YAPNR_RF_RUN_DIR"],
    main = "test_wilkinson.py",
    tags = _FULL_TAGS,
    deps = _DEPS,
)

