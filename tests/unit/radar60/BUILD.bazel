load("@yapnr_pypi//:requirements.bzl", "requirement")
load("//tools/bazel:py_tests.bzl", "yapnr_py_tests")

# The radar60 example's part data, land patterns and parts lock (examples/radar60/schematic), and
# the board integration's text and geometry steps (examples/radar60/board).
# Hermetic: the generators, the lock, the committed RF macro board and the floorplan; no KiCad
# library and no atopile.
yapnr_py_tests(
    data = ["//examples/radar60/schematic:parts_sources"],
    overrides = {
        "test_board_integration": {
            "data": [
                "//examples/radar60/board:integration_sources",
                "//examples/radar60/rf:rfm1_n",
            ],
            "deps": [requirement("pyyaml")],
        },
        "test_explore_rank": {
            "data": ["//examples/radar60/board:integration_sources"],
        },
        "test_integrate": {
            "data": ["//examples/radar60/board:integration_sources"],
            "deps": [requirement("pyyaml")],
        },
        "test_power_block": {
            "data": ["//examples/radar60/board:integration_sources"],
            "deps": [requirement("pyyaml")],
        },
    },
    deps = ["//yapnr/partcache"],
)
