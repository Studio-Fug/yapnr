load("@yapnr_pypi//:requirements.bzl", "requirement")
load("//tools/bazel:py_tests.bzl", "yapnr_py_tests")

# test_wheel inspects the unstamped wheel //release:wheel_for_test, which has
# the same contents and metadata as the release wheel apart from the version.
yapnr_py_tests(
    data = [
        "//:requirements-runtime.in",
        "//release:wheel_for_test",
    ],
    overrides = {
        # Loads the wheel's native library with yapnr.rf's loader.
        "test_wheel": {"deps": ["//yapnr/rf"]},
    },
    deps = [
        "//tools/release:release_lib",
        requirement("packaging"),
    ],
)
