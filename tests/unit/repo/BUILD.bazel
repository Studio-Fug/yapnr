load("@yapnr_pypi//:requirements.bzl", "requirement")
load("//tools/bazel:py_tests.bzl", "yapnr_py_tests")

# These checks read the whole working tree, which is not a declared input, so
# they are tagged `external`: Bazel always runs them and never caches a result.
# See tools/repo_root.py.
yapnr_py_tests(
    data = ["//:MODULE.bazel"],
    overrides = {
        "test_ci_lanes": {"deps": [
            "//tools/ci:ci_lib",
            requirement("pyyaml"),
        ]},
        # Whole-tree scanning needs headroom on shared runners; preserve every check.
        "test_privacy_scan": {"size": "medium"},
    },
    tags = [
        "external",
        "no-remote",
    ],
    deps = ["//tools:repo_checks"],
)
