load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:py_tests.bzl", "yapnr_py_tests")

# One thread per test (`YAPNR_RF_THREADS` caps torch's, the others numpy's and OpenMP's): Bazel
# runs as many tests side by side as the machine has cores, and with 4 threads each on CI's
# 4-vCPU runner they oversubscribed it 4 times over and timed out (design §24). numpy's
# OpenBLAS stays on one thread in any case: with its own threads spinning beside torch's, an
# adjoint run took 1.6 times as long.
_ENV = {
    "MKL_NUM_THREADS": "1",
    "OMP_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "YAPNR_RF_THREADS": "1",
}

# Fast tests (design §12): seconds to about four minutes each on one thread. The optimizer
# tests share a tiny two-port spec (//yapnr/rf:testing); the pipeline gradient and the tiny
# design are split in two files each so that the halves run side by side. Tests that took more
# than 40 s on one thread of the development Mac (shared with other work) get the long timeout
# (900 s): CI's runner is slower per core. test_kicad_cli runs in the KiCad lane only
# (headless kicad-cli in YAPNR_KICAD_CLI).
_SLOW = {
    "size": "medium",
    "timeout": "long",
}

_SLOW_TESTING = dict(
    _SLOW,
    deps = ["//yapnr/rf:testing"],
)

yapnr_py_tests(
    env = _ENV,
    overrides = {
        "test_adjoint_gradients": _SLOW,
        "test_animate": {
            "deps": [
                "//yapnr/rf:animate_lib",
                "//yapnr/rf:testing",
            ],
        },
        "test_balance": {
            "deps": ["//yapnr/rf:testing"],
            "size": "medium",
        },
        "test_dtft": _SLOW,
        "test_kicad_cli": {"tags": ["kicad"]},
        "test_lumped_ports": {"size": "medium"},
        "test_microstrip": _SLOW,
        "test_modes": _SLOW,
        # The kernel's equivalence on a library compiled with the host compiler (skips without
        # one); the optimizer and case comparisons run in test_native_kernel_native below.
        "test_native_kernel": dict(
            _SLOW_TESTING,
            env = dict(
                _ENV,
                YAPNR_RF_NATIVE_QUICK = "1",
            ),
        ),
        "test_pipeline_gradient": _SLOW_TESTING,
        "test_pipeline_gradient_options": _SLOW_TESTING,
        "test_ports": _SLOW,
        "test_power_balance": {"size": "medium"},
        "test_sheet": {"size": "medium"},
        "test_tiny_design": _SLOW_TESTING,
        "test_tiny_design_options": _SLOW_TESTING,
    },
    deps = ["//yapnr/rf"],
)

# The microstrip check repeated at twice the resolution: about 4 minutes on 4 threads, so it is
# manual (not part of `bazel test //...` or CI); run it when the solver changes:
#   bazel test //tests/unit/rf:test_microstrip_slow
py_test(
    name = "test_microstrip_slow",
    size = "large",
    srcs = ["test_microstrip.py"],
    env = dict(
        _ENV,
        MKL_NUM_THREADS = "4",
        OMP_NUM_THREADS = "4",
        YAPNR_RF_SLOW = "1",
        YAPNR_RF_THREADS = "4",
    ),
    main = "test_microstrip.py",
    tags = [
        "manual",
        "slow",
    ],
    deps = ["//yapnr/rf"],
)

# The native FDTD stepper (//yapnr/rf:libyapnr_fdtd.so, needs a C toolchain): its equivalence
# tests on the Bazel-built library, and the finite-difference gradient checks run on it
# (YAPNR_RF_BACKEND=native: exact problems and default simulations use the native stepper;
# YAPNR_RF_REQUIRE_NATIVE: an unloadable library fails them instead of running numpy).
#   bazel test //tests/unit/rf:test_native_kernel_native //tests/unit/rf:test_adjoint_gradients_native \
#     //tests/unit/rf:test_pipeline_gradient_native
py_test(
    name = "test_native_kernel_native",
    size = "medium",
    srcs = ["test_native_kernel.py"],
    data = ["//yapnr/rf:libyapnr_fdtd.so"],
    env = dict(
        _ENV,
        YAPNR_RF_REQUIRE_NATIVE = "1",
    ),
    main = "test_native_kernel.py",
    tags = [
        "manual",
        "native",
    ],
    deps = [
        "//yapnr/rf",
        "//yapnr/rf:testing",
    ],
)

[
    py_test(
        name = name + "_native",
        size = "medium",
        srcs = [name + ".py"],
        data = ["//yapnr/rf:libyapnr_fdtd.so"],
        env = dict(
            _ENV,
            YAPNR_RF_BACKEND = "native",
            YAPNR_RF_REQUIRE_NATIVE = "1",
        ),
        main = name + ".py",
        tags = [
            "manual",
            "native",
        ],
        deps = [
            "//yapnr/rf",
            "//yapnr/rf:testing",
        ],
    )
    for name in [
        "test_adjoint_gradients",
        "test_pipeline_gradient",
    ]
]
