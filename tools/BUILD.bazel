load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

# The package marker alone, for libraries below tools/ (//tools/ci:ci_lib). Without it their
# runfiles get an auto-created, empty tools/__init__.py, and Bazel 7's sandbox reuse has written
# such an empty file through a reused symlink, truncating tools/__init__.py in the source tree
# (as //yapnr:package explains for yapnr/).
py_library(
    name = "package",
    srcs = ["__init__.py"],
    imports = [".."],
)

# Repository checks. Stdlib-only and Python 3.9 compatible: the pre-commit hook
# runs tools/privacy_scan.py directly with the system python3.
py_library(
    name = "repo_checks",
    srcs = [
        "__init__.py",
        "check_part_data.py",
        "check_test_wiring.py",
        "privacy_scan.py",
        "repo_root.py",
    ],
    # Read next to privacy_scan.py: the commit addresses `--identities` accepts
    # besides GitHub noreply addresses, and the IANA root zone top-level
    # domains (an `@` match is an e-mail address only at one of them).
    data = [
        "privacy/allowed_identities.txt",
        "privacy/iana_tlds.txt",
    ],
    imports = [".."],
)

# `bazel run //tools:privacy_scan -- --all --root "$PWD"`
py_binary(
    name = "privacy_scan",
    srcs = ["privacy_scan.py"],
    main = "privacy_scan.py",
    deps = [":repo_checks"],
)

# `bazel run //tools:check_test_wiring -- --root "$PWD"`
py_binary(
    name = "check_test_wiring",
    srcs = ["check_test_wiring.py"],
    main = "check_test_wiring.py",
    deps = [":repo_checks"],
)
