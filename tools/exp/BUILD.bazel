load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

# Stage-plan generators for `yapnr exp` campaigns (docs/cloud-experiments.md). rf_job.py,
# rf_diag.py, openems_job.py and palace_job.py run inside the tasks, from the job bundles the
# generators write; image_tasks.py is what the task-image generators (openEMS, Palace) share.
py_library(
    name = "exp_lib",
    srcs = [
        "__init__.py",
        "image_tasks.py",
        "openems_job.py",
        "openems_plan.py",
        "palace_job.py",
        "palace_plan.py",
        "pnr_explore_job.py",
        "pnr_explore_plan.py",
        "rf_diag.py",
        "rf_job.py",
        "rf_stage_plan.py",
    ],
    imports = ["../.."],
    deps = ["//tools:package"],
)

# `bazel run //tools/exp:openems_plan -- plan JOBS.toml --out DIR` (plan, digests, collect; the
# `image` build reads docker/openems, so run that one as python3 tools/exp/openems_plan.py).
py_binary(
    name = "openems_plan",
    srcs = ["openems_plan.py"],
    main = "openems_plan.py",
    deps = [
        ":exp_lib",
        "//yapnr/exp",
    ],
)

# `bazel run //tools/exp:palace_plan -- plan JOBS.toml --out DIR` (plan, digests, collect; the
# `image` build reads docker/palace, so run that one as python3 tools/exp/palace_plan.py).
py_binary(
    name = "palace_plan",
    srcs = ["palace_plan.py"],
    main = "palace_plan.py",
    deps = [
        ":exp_lib",
        "//yapnr/exp",
    ],
)

# `bazel run //tools/exp:rf_stage_plan -- JOBS.toml --repo CHECKOUT --out DIR`
py_binary(
    name = "rf_stage_plan",
    srcs = ["rf_stage_plan.py"],
    main = "rf_stage_plan.py",
    deps = [":exp_lib"],
)

# `bazel run //tools/exp:pnr_explore_plan -- JOBS.toml --repo CHECKOUT --out DIR`: N placement
# seeds and/or candidate placements of any `integrate.py`-shaped board driver into one mc-eval
# campaign (docs/cloud-experiments.md, "Any command as a task"); pnr_explore_job.py is the
# runner the job bundle ships and every task runs.
py_binary(
    name = "pnr_explore_plan",
    srcs = ["pnr_explore_plan.py"],
    main = "pnr_explore_plan.py",
    deps = [":exp_lib"],
)
