load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@yapnr_pypi//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

# The package marker, for the files KiCad-side workers stage (//yapnr/fab:capability_files).
exports_files(["__init__.py"])

py_library(
    name = "yapnr",
    srcs = [
        "__init__.py",
        "__main__.py",
        "cli.py",
        "frontends/__init__.py",
    ],
    imports = [".."],
    # The `atopile`, `picker`, `part-cache`, `exp`, `fab` and `order` commands (imported when the
    # parser is built).
    deps = [
        "//yapnr/exp",
        "//yapnr/fab",
        "//yapnr/frontends/atopile",
        "//yapnr/order",
        "//yapnr/partcache",
    ],
)

# The package markers alone, for libraries that need no CLI (the picker, the part cache and the
# atopile frontend depend on it). Without it their runfiles get auto-created, empty
# `__init__.py` files where other targets have these real ones, and Bazel 7's sandbox reuse
# (on by default) once wrote such an empty file through a reused symlink, truncating
# yapnr/__init__.py in the source tree.
py_library(
    name = "package",
    srcs = [
        "__init__.py",
        "frontends/__init__.py",
    ],
    imports = [".."],
)

# The engine's numerical stack. `yapnr doctor` reports its versions, and every
# engine subpackage imported in later PRs depends on it.
_NUMERIC_DEPS = [
    requirement("numpy"),
    requirement("torch"),
]

# `bazel run //:yapnr -- <args>` (alias in the root package).
py_binary(
    name = "cli",
    srcs = ["cli.py"],
    main = "cli.py",
    deps = [":yapnr"] + _NUMERIC_DEPS,
)

# `bazel run //:doctor`: the same binary with the doctor command preset.
py_binary(
    name = "doctor",
    srcs = ["cli.py"],
    args = ["doctor"],
    main = "cli.py",
    deps = [":yapnr"] + _NUMERIC_DEPS,
)
