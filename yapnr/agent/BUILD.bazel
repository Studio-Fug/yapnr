load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "instructions",
    srcs = ["//:AGENTS.md"],
    outs = ["AGENTS.md"],
    cmd = "cp $(location //:AGENTS.md) $@",
)

genrule(
    name = "workflow",
    srcs = ["//docs:agent-workflow.md"],
    outs = ["workflow.md"],
    cmd = "cp $(location //docs:agent-workflow.md) $@",
)

py_library(
    name = "agent",
    srcs = [
        "__init__.py",
        "cli.py",
        "workflow.py",
    ],
    data = [
        "workflow.json",
        ":instructions",
        ":workflow",
    ],
    deps = ["//yapnr:package"],
)
