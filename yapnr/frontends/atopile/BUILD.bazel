"""The atopile toolchain without Nix (docs/frontends/atopile.md).

- :atopile is the library: the pinned atopile environment (setup and discovery).
- :picker is the offline picker and the catalog schema. Stdlib only.
- :testing writes synthetic parts and projects for tests.
- The locks (locks/) are data: `yapnr atopile setup` installs from them; they are regenerated by
  tools/atopile/update_locks.sh.
"""

load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

# The offline picker and the catalog schema, on their own: the part cache (//yapnr/partcache)
# serves the same components API and catalogs.
py_library(
    name = "picker",
    srcs = [
        "__init__.py",
        "picker/__init__.py",
        "picker/catalog.py",
        "picker/server.py",
    ],
    imports = ["../../.."],
)

py_library(
    name = "atopile",
    srcs = [
        "proc.py",
        "toolchain.py",
    ],
    data = [
        "locks/build-requirements-linux-aarch64.lock",
        "locks/build-requirements.in",
        "locks/pins.json",
        "locks/requirements-darwin-arm64.lock",
        "locks/requirements-darwin-x86_64.lock",
        "locks/requirements-linux-aarch64.lock",
        "locks/requirements-linux-x86_64.lock",
        "locks/requirements.in",
    ],
    imports = ["../../.."],
    deps = [":picker"],
)

# Synthetic parts and projects for tests (never real product data); not in the wheel.
py_library(
    name = "testing",
    testonly = True,
    srcs = ["testing.py"],
    imports = ["../../.."],
    deps = [":picker"],
)
