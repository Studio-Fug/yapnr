"""The atopile toolchain without Nix (docs/frontends/atopile.md).

- :atopile is the library: toolchain setup and discovery, the runner, the parts lock; :picker
  the offline picker and catalog schema. Stdlib only (plus PyYAML for ato.yaml paths), so no
  numerical stack comes along.
- The hook (hook/) is data: it runs inside atopile's own Python 3.14 interpreter during a build,
  never in Bazel's.
- The locks (locks/) are data: `yapnr atopile setup` installs from them; they are regenerated by
  tools/atopile/update_locks.sh.
"""

load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@yapnr_pypi//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

# The offline picker and the catalog schema, on their own: the part cache (//yapnr/partcache)
# serves the same components API and catalogs, and :atopile uses the cache.
py_library(
    name = "picker",
    srcs = [
        "__init__.py",
        "picker/__init__.py",
        "picker/catalog.py",
        "picker/discovery.py",
        "picker/server.py",
    ],
    imports = ["../../.."],
    deps = ["//yapnr:package"],
)

py_library(
    name = "atopile",
    srcs = [
        "cli.py",
        "env.py",
        "kicad.py",
        "outline.py",
        "parts.py",
        "proc.py",
        "runner.py",
        "toolchain.py",
    ],
    data = [
        "hook/sitecustomize.py",
        "hook/yapnr_atopile_hook.py",
        "locks/build-requirements.in",
        "locks/build-requirements-linux-aarch64.lock",
        "locks/pins.json",
        "locks/requirements.in",
        "locks/requirements-darwin-arm64.lock",
        "locks/requirements-darwin-x86_64.lock",
        "locks/requirements-linux-aarch64.lock",
        "locks/requirements-linux-x86_64.lock",
        "locks/sdist-build-requirements.in",
        "locks/sdist-build-requirements-linux-aarch64.lock",
    ],
    imports = ["../../.."],
    deps = [
        ":picker",
        "//yapnr/partcache",
        requirement("pyyaml"),
    ],
)

# Synthetic parts and projects for tests (never real product data); not in the wheel.
py_library(
    name = "testing",
    testonly = True,
    srcs = ["testing.py"],
    imports = ["../../.."],
    deps = [":picker"],
)

# The build action of @yapnr//bazel/atopile:defs.bzl (yapnr_atopile_build): the runner alone,
# without the numerical stack of //:yapnr.
py_binary(
    name = "build_tool",
    srcs = ["build_tool.py"],
    main = "build_tool.py",
    deps = [":atopile"],
)
