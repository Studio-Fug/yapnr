"""yapnr.rf: RF microstrip inverse design (docs/design/rf-topology-optimization.md)."""

load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@yapnr_pypi//:requirements.bzl", "requirement")
load("//tools/bazel:native_cc.bzl", "native_shared_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "rf",
    srcs = glob(
        ["**/*.py"],
        exclude = [
            "animate.py",
            "testing.py",
        ],
    ),
    # The native stepper's C source travels with the library (runfiles, a bazel_dep), so it can
    # be built where it runs (python -m yapnr.rf.fdtd.native_kernel build); nothing compiles it
    # by default. (yapnr.rf is not in the yapnr wheel: //yapnr does not depend on it.)
    data = glob([
        "fdtd/native/*.c",
        "fdtd/native/*.h",
    ]),
    imports = ["../.."],
    deps = [
        "//yapnr:package",
        requirement("numpy"),
        requirement("pyyaml"),
        requirement("torch"),
    ],
)

# The package marker alone (yapnr/rf/__init__.py), for subpackages that need none of the solver
# (//yapnr/rf/coupons): without it their runfiles would get an auto-created, empty one.
py_library(
    name = "package",
    srcs = ["__init__.py"],
    imports = ["../.."],
    deps = ["//yapnr:package"],
)

# Test helpers (a tiny spec), for tests only.
py_library(
    name = "testing",
    testonly = True,
    srcs = ["testing.py"],
    imports = ["../.."],
    deps = [":rf"],
)

# The optimization animation (design §10.5): Pillow only, like pnr.animate.
py_library(
    name = "animate_lib",
    srcs = ["animate.py"],
    imports = ["../.."],
    deps = [
        ":rf",
        requirement("pillow"),
    ],
)

# bazel run //yapnr/rf:animate -- RUN_DIR --out PATH.webp (python -m yapnr.rf.animate).
py_binary(
    name = "animate",
    srcs = ["animate.py"],
    main = "animate.py",
    deps = [":animate_lib"],
)

# Optional native FDTD stepper (yapnr.rf.fdtd.native_kernel, backend "native"): blocks of Yee
# steps in C on a thread pool, loaded with ctypes. No floating-point contraction, so float64
# runs are bit-identical to the numpy reference. Nothing depends on it; without it backend
# "native" runs numpy. Manual: `bazel build //...` and `bazel test //...` need no C toolchain
# (the unit test compiles the source with a host compiler when there is one); the
# //tests/unit/rf:*_native targets run on this library.
native_shared_library(
    name = "libyapnr_fdtd.so",
    srcs = [
        "fdtd/native/fdtd.c",
        "fdtd/native/fdtd_kernels.h",
    ],
    copts = [
        "-O3",
        "-std=c11",
        "-ffp-contract=off",
        "-fno-fast-math",
    ],
    linkopts = ["-pthread"],
    tags = ["manual"],
)
