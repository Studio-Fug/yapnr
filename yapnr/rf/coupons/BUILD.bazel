"""yapnr.rf.coupons: fab-model test coupons (docs/design/rf-fab-coupons.md, docs/rf-fab-coupons.md).

numpy and PyYAML only; no torch. The 2D cross-section solver (xsec.py, families.py `build`)
imports scikit-fem and gmsh lazily: it runs in the FEA environment, never under Bazel, and the
shipped tables in data/ are what the fit reads. It needs nothing of the RF solver's FDTD/torch
chain, only that package's marker (//yapnr/rf:package) and the numpy-only export helpers
(//yapnr/rf/export) that `catalog.o_optimized` uses to read a validated footprint's contour.

`catalog.o_optimized`'s D1_WINNER and D2_WINNER also need //docs/rf/order0:winners in the data
closure (review finding 5): without it, a sandboxed run cannot see the winner file at all, and
raises rather than the silent placeholder fallback it used to be.
"""

load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@yapnr_pypi//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "coupons",
    srcs = glob(
        ["*.py"],
        exclude = ["__main__.py"],
    ),
    data = glob(["data/*.json"]) + ["//docs/rf/order0:winners"],
    imports = ["../../.."],
    deps = [
        "//yapnr:package",
        "//yapnr/rf:package",
        "//yapnr/rf/export",
        requirement("numpy"),
        requirement("pyyaml"),
    ],
)

# bazel run //yapnr/rf/coupons:cli -- <command> ...  (python -m yapnr.rf.coupons)
py_binary(
    name = "cli",
    srcs = ["__main__.py"],
    main = "__main__.py",
    deps = [":coupons"],
)

# Package collection only: no architecture-specific pip dependency closure.
py_library(
    name = "wheel_files",
    srcs = glob(["**/*.py"]),
    data = glob(["data/*.json"]) + [
        ":winner_0",
        ":winner_1",
        ":winner_2",
    ],
    imports = ["../../.."],
    deps = ["//yapnr/rf:package"],
)

genrule(
    name = "winner_0",
    srcs = [
        "//docs/rf/order0:predictions/D1-d1c/runs/d1-star/footprint.kicad_mod",
        "//docs/rf/order0:predictions/D1-d1c/runs/d1-star/result.json",
    ],
    outs = [
        "data/winners/predictions/D1-d1c/runs/d1-star/footprint.kicad_mod",
        "data/winners/predictions/D1-d1c/runs/d1-star/result.json",
    ],
    cmd = "cp $(location //docs/rf/order0:predictions/D1-d1c/runs/d1-star/footprint.kicad_mod) $(location data/winners/predictions/D1-d1c/runs/d1-star/footprint.kicad_mod) && cp $(location //docs/rf/order0:predictions/D1-d1c/runs/d1-star/result.json) $(location data/winners/predictions/D1-d1c/runs/d1-star/result.json)",
)

genrule(
    name = "winner_1",
    srcs = [
        "//docs/rf/order0:predictions/D1/runs/d1-star/footprint.kicad_mod",
        "//docs/rf/order0:predictions/D1/runs/d1-star/result.json",
    ],
    outs = [
        "data/winners/predictions/D1/runs/d1-star/footprint.kicad_mod",
        "data/winners/predictions/D1/runs/d1-star/result.json",
    ],
    cmd = "cp $(location //docs/rf/order0:predictions/D1/runs/d1-star/footprint.kicad_mod) $(location data/winners/predictions/D1/runs/d1-star/footprint.kicad_mod) && cp $(location //docs/rf/order0:predictions/D1/runs/d1-star/result.json) $(location data/winners/predictions/D1/runs/d1-star/result.json)",
)

genrule(
    name = "winner_2",
    srcs = [
        "//docs/rf/order0:predictions/D2/runs/d2-star-sched/footprint.kicad_mod",
        "//docs/rf/order0:predictions/D2/runs/d2-star-sched/result.json",
    ],
    outs = [
        "data/winners/predictions/D2/runs/d2-star-sched/footprint.kicad_mod",
        "data/winners/predictions/D2/runs/d2-star-sched/result.json",
    ],
    cmd = "cp $(location //docs/rf/order0:predictions/D2/runs/d2-star-sched/footprint.kicad_mod) $(location data/winners/predictions/D2/runs/d2-star-sched/footprint.kicad_mod) && cp $(location //docs/rf/order0:predictions/D2/runs/d2-star-sched/result.json) $(location data/winners/predictions/D2/runs/d2-star-sched/result.json)",
)
