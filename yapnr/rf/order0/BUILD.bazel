load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

# Order 0's RF demos (docs/rf/order0/): specs and formulations of D1/D2, the references' and
# run 0b's forward-run directories, criteria, the loss correction. It uses the solver (specs, the
# exporter for the forward runs) and the coupon package (the board's windows, R1/R1t, the
# equivalent substrates, the coupon line model); the predictions stage's loss correction per
# substrate and the resonators' notches (predict.py).
py_library(
    name = "order0",
    srcs = [
        "__init__.py",
        "demos.py",
        "predict.py",
        "write.py",
    ],
    imports = ["../../.."],
    deps = [
        "//yapnr:package",
        "//yapnr/rf",
        "//yapnr/rf/coupons",
    ],
)

# bazel run //yapnr/rf/order0:cli -- write --out DIR  (python -m yapnr.rf.order0)
py_binary(
    name = "cli",
    srcs = ["__main__.py"],
    main = "__main__.py",
    deps = [":order0"],
)

# Package collection only: no architecture-specific pip dependency closure.
py_library(
    name = "wheel_files",
    srcs = glob(["**/*.py"]),
    imports = ["../../.."],
    deps = ["//yapnr/rf:package"],
)
